# Copy this file to .env and fill in your values

# API Configuration
NUXT_PUBLIC_API_URL=https://your-api-server.com/api/v1/
NUXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# API Credentials
NUXT_API_USERNAME=your_username
NUXT_API_PASSWORD=your_password

# AI Consultant Widget
NUXT_PUBLIC_CONSULTANT_KEY=your_widget_key